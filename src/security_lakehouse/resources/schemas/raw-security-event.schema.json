{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawSecurityEvent",
  "type": "object",
  "required": [
    "event_id",
    "tenant_id",
    "event_time",
    "source",
    "event_type",
    "entity"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "entity": {
      "type": "object"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info", "none"]
    },
    "status": {
      "type": "string"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "evidence_collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "attributes": {
      "type": "object"
    },
    "safeguard_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": true
}
