# Build context exclusions (keep image small + reproducible).
.git
.github
.claude/
.venv
.pytest_cache
.mypy_cache/
.ruff_cache/
__pycache__
*.pyc
*.pyo
*.egg-info
build/
dist/
.DS_Store

# Not read by any Dockerfile COPY: tests, docs, examples, sample evidence,
# and dev tooling. Excluding them keeps the build context small and stops an
# edit there from invalidating the image cache.
**/node_modules/
tests/
docs/
examples/
data/
tools/

# Compose server secrets — never bake them into the image.
grc-lake.env
trustops.env

# Local lakes — never bake customer evidence into the image.
build/lakehouse/
build/lakehouse-*
build/dashboard/

# Web build outputs (the Dockerfile builds these fresh inside web-build).
app/web/node_modules/
app/web/.next/
app/web/out/
app/web/test-results/
app/web/playwright-report/
src/security_lakehouse/web/dist/*
!src/security_lakehouse/web/dist/.gitkeep

# Local credentials/configuration and browser traces are not build inputs.
**/.env
**/.env.*
.aws/
.azure/
.config/gcloud/

# Editor + scratch
.idea/
.vscode/
*.swp
