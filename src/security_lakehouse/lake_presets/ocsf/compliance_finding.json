{
  "spec_version": 1,
  "name": "ocsf_compliance_finding",
  "description": "OCSF Compliance Finding (class_uid 2003), OCSF 1.1.0 (Amazon Security Lake source version 2). Configuration-check results; compliance.status_id drives pass/open.",
  "source": {
    "table": "ocsf_table",
    "incremental": true,
    "lookback_minutes": 60
  },
  "filters": [
    {
      "column": "class_uid",
      "op": "eq",
      "value": 2003
    }
  ],
  "fields": {
    "id": {
      "column": "finding_info.uid"
    },
    "observed_at": {
      "column": "time_dt",
      "format": "timestamp"
    },
    "source": {
      "coalesce": [
        {
          "column": "metadata.product.name"
        },
        {
          "const": "ocsf"
        }
      ]
    },
    "severity": {
      "column": "severity_id",
      "map": {
        "0": "info",
        "1": "info",
        "2": "low",
        "3": "medium",
        "4": "high",
        "5": "critical",
        "6": "critical",
        "99": "info"
      },
      "default": "info"
    },
    "event_type": {
      "const": "ocsf.compliance_finding"
    },
    "asset_id": {
      "coalesce": [
        {
          "column": "resource.uid"
        },
        {
          "column": "cloud.account.uid"
        }
      ]
    },
    "asset_type": {
      "coalesce": [
        {
          "column": "resource.type"
        },
        {
          "const": "cloud_resource"
        }
      ]
    },
    "status": {
      "column": "compliance.status_id",
      "map": {
        "1": "pass",
        "2": "observed",
        "3": "open"
      },
      "default": "observed"
    },
    "evidence_ref": {
      "column": "finding_info.src_url"
    },
    "controls": {
      "const": [
        "SOC2-CC7.1",
        "ISO27001-A.8.9",
        "NIST-800-53-CM-6",
        "NIST-800-53-CA-7"
      ]
    }
  },
  "attributes": {
    "ocsf_class_uid": {
      "column": "class_uid"
    },
    "ocsf_activity_id": {
      "column": "activity_id"
    },
    "ocsf_version": {
      "column": "metadata.version"
    },
    "product": {
      "column": "metadata.product.name"
    },
    "vendor": {
      "column": "metadata.product.vendor_name"
    },
    "cloud_account": {
      "column": "cloud.account.uid"
    },
    "cloud_region": {
      "column": "cloud.region"
    },
    "finding_uid": {
      "column": "finding_info.uid"
    },
    "finding_title": {
      "column": "finding_info.title"
    },
    "finding_status": {
      "column": "status"
    },
    "compliance_status": {
      "column": "compliance.status"
    },
    "compliance_control": {
      "column": "compliance.control"
    },
    "compliance_standards": {
      "column": "compliance.standards"
    }
  }
}
