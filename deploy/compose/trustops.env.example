# Settings and secrets for the `trustops-server` Compose service.
#
#   cp deploy/compose/trustops.env.example trustops.env
#   chmod 600 trustops.env
#
# trustops.env is gitignored. Never commit a filled-in copy.

# Required. Signs browser sessions and the mapping-review log tip.
# Generate with: openssl rand -hex 32
TRUSTOPS_COOKIE_SIGNING_KEY=

# The HTTPS URL people use to reach this deployment through your TLS proxy.
TRUSTOPS_PUBLIC_URL=

# OIDC single sign-on for people (see docs/SERVER_AUTH.md). Left empty, OIDC
# stays off. TRUSTOPS_SESSION_SECRET is required once OIDC is configured;
# generate it with: openssl rand -hex 32
TRUSTOPS_OIDC_ISSUER=
TRUSTOPS_OIDC_CLIENT_ID=
TRUSTOPS_OIDC_CLIENT_SECRET=
TRUSTOPS_OIDC_TENANT_SLUG=
TRUSTOPS_OIDC_AUTO_PROVISION=false
TRUSTOPS_SESSION_SECRET=
