# Settings and secrets for the `grc-lake-server` Compose service.
#
#   cp deploy/compose/grc-lake.env.example grc-lake.env
#   chmod 600 grc-lake.env
#
# grc-lake.env is gitignored. Never commit a filled-in copy.

# Required. Signs browser sessions and the mapping-review log tip.
# Generate with: openssl rand -hex 32
GRC_LAKE_COOKIE_SIGNING_KEY=

# The HTTPS URL people use to reach this deployment through your TLS proxy.
GRC_LAKE_PUBLIC_URL=

# OIDC single sign-on for people (see docs/SERVER_AUTH.md). Left empty, OIDC
# stays off. GRC_LAKE_SESSION_SECRET is required once OIDC is configured;
# generate it with: openssl rand -hex 32
GRC_LAKE_OIDC_ISSUER=
GRC_LAKE_OIDC_CLIENT_ID=
GRC_LAKE_OIDC_CLIENT_SECRET=
GRC_LAKE_OIDC_TENANT_SLUG=
GRC_LAKE_OIDC_AUTO_PROVISION=false
# Comma-separated email domains auto-provisioning may admit; required when it is on.
GRC_LAKE_OIDC_ALLOWED_DOMAINS=
GRC_LAKE_SESSION_SECRET=
